function tarotTimelineTiming() {
  const clip = 'TarotBookTimelineInfoItem_FadeIn.anim';
  const keys = (path, attribute) => (tarotCurve(clip, path, attribute)?.keys ?? []).map((key) => ({ time: Number(key.time), value: Number(key.value) || 0 }));
  const scale = (path) => (tarotCurve(clip, path, '')?.keys ?? []).map((key) => ({ time: Number(key.time), value: Number(String(key.value).match(/x:\s*([-\d.e]+)/)?.[1] ?? 0) }));
  const rows = ['Left1', 'Left2', 'Left3', 'Right1', 'Right2', 'Right3', 'Active1', 'Active2', 'Active3', 'Active4'];
  return {
    title: scale('Main/MainTitle'),
    rows: Object.fromEntries(rows.map((row) => [row, {
      root: scale(`Main/DataList/${row}/Root`),
      outline: keys(`Main/DataList/${row}/Root/Fill/Outline`, 'm_Alpha'),
    }])),
    icon: scale('Main/IconPanel'),
  };
}

function tarotReverseTiming(clipName, path, attribute) {
  const curve = tarotFloatCurve(clipName, path, attribute);
  const keys = curve?.keys ?? [];
  if (keys.length < 2) return null;
  const start = Number(keys[0].time);
  const end = Number(keys[keys.length - 1].time);
  const values = keys.map((key) => Number(key.value) || 0);
  return { delay: start, duration: Math.max(0.05, end - start), values, path };
}

function tarotHomeExitAllCurves() {
  const clip = 'TarotBookRealMainPage_FadeOutAll.anim';
  // Scale keys hold Unity vector strings; tarotCurveValues would coerce them
  // to 0, so keep the raw values for the runtime CSS scale generator.
  const scale = (path) => (tarotCurve(clip, path, '')?.keys ?? []).map((key) => ({ time: Number(key.time), value: key.value }));
  const alpha = (path, attribute = 'm_Alpha') => tarotCurveValues(clip, path, attribute);
  return {
    bgScale: scale('Bg'),
    desktopBgScale: scale('Root/PanelContent/DesktopPanel/Bg'),
    root: alpha('Root'),
    bg: alpha('Bg'),
    effOpen: alpha('Bg/EffOpen', 'm_IsActive'),
    screen: alpha('Bg/ScreenBg'),
    bottomBar: alpha('Bg/ScreenBg/BottomBar'),
    bgRootEff: alpha('Bg/ScreenBg/RevertMask/BgRoot/EffLoop', '_TargetAlpha'),
    close: alpha('Outside/BtnClose'),
    pageInfo: alpha('Outside/PageInfo'),
    pageInfoX: alpha('Outside/PageInfo', 'm_AnchoredPosition.x'),
    reward: alpha('Outside/RewardPanel'),
    rewardX: alpha('Outside/RewardPanel', 'm_AnchoredPosition.x'),
    desktop: alpha('Root/PanelContent/DesktopPanel'),
    desktopBg: alpha('Root/PanelContent/DesktopPanel/Bg'),
    goToPanel: alpha('Root/PanelContent/GoToPanel'),
  };
}

function tarotHomeExitTimings() {
  const out = {};
  for (const [name, clip] of [['normal', 'TarotBookRealMainPage_FadeOut.anim'], ['all', 'TarotBookRealMainPage_FadeOutAll.anim']]) {
    out[name] = {
      root: tarotReverseTiming(clip, 'Root', 'm_Alpha'),
      screen: tarotReverseTiming(clip, 'Bg/ScreenBg', 'm_Alpha'),
      close: tarotReverseTiming(clip, 'Outside/BtnClose', 'm_Alpha'),
      pageInfo: tarotReverseTiming(clip, 'Outside/PageInfo', 'm_Alpha'),
