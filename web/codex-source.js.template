/* 解包资料到 CSS 的桥接层。只读取构建期生成的 codex-source.json，
   不在运行时加载任何图片、SVG 或外部资源。 */
const TAROT_SOURCE = __TAROT_SOURCE__;

function tarotTextStyle(name, textKey) {
  const styles = TAROT_SOURCE.typography?.styles || [];
  return styles.find((style) => style.name === name && (!textKey || style.textKey === textKey)) || null;
}

function tarotTypography() {
  return {
    title: tarotTextStyle('TitleText', '如我所书'),
    status: tarotTextStyle('TitleText', 'DevUI_TimeTitle'),
    functionName: tarotTextStyle('FunctionName', '逐火者的命路.exe'),
    hint: tarotTextStyle('HintText', 'DevUI_TipContent'),
    count: tarotTextStyle('CountText', '主界面'),
    caption: tarotTextStyle('Text', '前往查看'),
    author: tarotTextStyle('Text', '著者的菲仪'),
    load: tarotTextStyle('Text', '载入'),
    introBody: tarotTextStyle('Text', '翻开这本书吧，'),
  };
}

function tarotCurve(clipName, path, attribute) {
  const clip = TAROT_SOURCE.animations.find((item) => item.file === clipName);
  return clip && clip.curves.find((curve) => curve.path === path && curve.attribute === attribute);
}

function tarotFloatCurve(clipName, path, attribute) {
  const curve = tarotCurve(clipName, path, attribute);
  if (!curve || curve.collection !== 'm_FloatCurves') return null;
  // Unity writes constant alpha 0 as a string; normalise it before timing math.
  if (Array.isArray(curve.keys)) {
    for (const key of curve.keys) {
      if (typeof key.value === 'string' && key.value.trim() !== '' && Number.isFinite(Number(key.value))) {
        key.value = Number(key.value);
      }
    }
  }
  return curve;
}

function tarotTiming(clipName, path, attribute) {
  const curve = tarotFloatCurve(clipName, path, attribute);
  const keys = curve?.keys ?? [];
  if (!keys.length) return { delay: 0, duration: 0, keys: [] };
  const start = Number(keys[0].time);
  const end = Number(keys[keys.length - 1].time);
  return { delay: start, duration: Math.max(0.05, end - start), keys };
}

// FunctionList button order is BtnBook, BtnStar, BtnMem, BtnPaper, BtnWiki,
// BtnMail. Loop1 animates Icon1..Icon6 in that same source order; expose both
// names so consumers can map by button without guessing.
const TAROT_ICON_ORDER = ['Icon1', 'Icon2', 'Icon3', 'Icon4', 'Icon5', 'Icon6'];
const TAROT_BUTTON_ORDER = ['BtnBook', 'BtnStar', 'BtnMem', 'BtnPaper', 'BtnWiki', 'BtnMail'];

function tarotIconCurve(name, attribute) {
  return tarotCurve('TarotBookRealMainPageIcon_Loop1.anim', name, attribute);
}

function vectorAxis(value, axis) {
  const match = String(value).match(new RegExp(`${axis}:\\s*([-\\d.e]+)`));
  return match ? Number(match[1]) : 0;
}

function tarotIconTimingByName(name) {
  const out = {};
  for (const attribute of ['m_AnchoredPosition.x', 'm_AnchoredPosition.y']) {
    const curve = tarotIconCurve(name, attribute);
    const keys = curve?.keys ?? [];
    if (!keys.length) continue;
    out[attribute] = {
      ...tarotTiming('TarotBookRealMainPageIcon_Loop1.anim', name, attribute),
      values: keys.map((key) => Number(key.value) || 0),
      timePeak: Number(keys[1]?.time ?? keys[0]?.time ?? 0),
    };
  }
  // Loop1 also animates each icon's Euler rotation and scale; keep the axis
  // values so CSS can reproduce the official peak instead of a generic wobble.
  const rotation = tarotCurve('TarotBookRealMainPageIcon_Loop1.anim', name, '');
  if (rotation && rotation.collection === 'm_EulerCurves') {
    out.rotation = {
      values: rotation.keys.map((key) => vectorAxis(key.value, 'z')),
      timePeak: Number(rotation.keys[1]?.time ?? rotation.keys[0]?.time ?? 0),
      duration: Number(rotation.keys[rotation.keys.length - 1]?.time ?? 0) - Number(rotation.keys[0]?.time ?? 0),
    };
  }
  const scaleCurve = tarotCurve('TarotBookRealMainPageIcon_Loop1.anim', name, '') === rotation
    ? (TAROT_SOURCE.animations.find((item) => item.file === 'TarotBookRealMainPageIcon_Loop1.anim')?.curves || [])
        .find((curve) => curve.path === name && curve.collection === 'm_ScaleCurves')
    : null;
  if (scaleCurve) {
    out.scale = {
      valuesX: scaleCurve.keys.map((key) => vectorAxis(key.value, 'x')),
      valuesY: scaleCurve.keys.map((key) => vectorAxis(key.value, 'y')),
      timePeak: Number(scaleCurve.keys[1]?.time ?? scaleCurve.keys[0]?.time ?? 0),
      duration: Number(scaleCurve.keys[scaleCurve.length - 1]?.time ?? 0) - Number(scaleCurve.keys[0]?.time ?? 0) || 3.266667,
    };
  }
  return out;
}

function tarotIconTimings() {
  const out = {};
  TAROT_ICON_ORDER.forEach((icon, index) => {
    const timing = tarotIconTimingByName(icon);
    out[icon] = timing;
    out[TAROT_BUTTON_ORDER[index]] = timing;
  });
  return out;
}

// Decorative loops target sub-icons inside the six function buttons. The
// prefab paths distinguish otherwise identical Icon1/Icon2 names, so keep the
// full path in each specification instead of guessing by basename.
const TAROT_DECORATIVE_LOOPS = [
  { file: 'TarotBookRealMainPageIcon_Loop2.anim', button: 'BtnStar', path: 'TarotBookMainIconStar/Deco1', duration: 60.116665, durationSeconds: true },
  { file: 'TarotBookRealMainPageIcon_Loop3.anim', button: 'BtnMem', path: 'Icon5', children: ['Icon5/Icon4', 'Icon5/Icon6', 'Icon7', 'Icon7/Icon2', 'Icon7/Icon3'], duration: 4 },
  { file: 'TarotBookRealMainPageIcon_Loop4.anim', button: 'BtnPaper', path: 'Icon1', children: ['Icon1/Icon4', 'Icon2', 'Icon2/Icon3'], duration: 6.85 },
  { file: 'TarotBookRealMainPageIcon_Loop5.anim', button: 'BtnMail', path: 'Icon1', duration: 3.7 },
  { file: 'TarotBookRealMainPageIcon_Loop6.anim', button: 'BtnMail', path: 'Icon1', children: ['Icon3', 'Icon3/Icon3 (1)'], duration: 9.983334 },
];

function tarotDecorativeLoopTimings() {
  const out = {};
  for (const spec of TAROT_DECORATIVE_LOOPS) {
    const clip = TAROT_SOURCE.animations.find((item) => item.file === spec.file);
    const paths = [spec.path, ...(spec.children || [])];
    const curves = (clip?.curves || []).filter((curve) => paths.includes(curve.path));
    const position = curves.filter((curve) => curve.collection === 'm_FloatCurves' && curve.attribute.startsWith('m_AnchoredPosition.'));
    const rotationCurves = curves.filter((curve) => curve.collection === 'm_EulerCurves');
    const rotation = rotationCurves.find((curve) => curve.path === spec.path) || rotationCurves[0];
    const scale = curves.find((curve) => curve.collection === 'm_ScaleCurves');
    const alpha = curves.find((curve) => curve.collection === 'm_FloatCurves' && curve.attribute === 'm_Color.a');
    const keys = (curve) => (curve?.keys || []).map((key) => ({
      time: Number(key.time),
      value: Number(key.value) || 0,
    }));
    const entry = {
      button: spec.button,
      file: spec.file,
      path: spec.path,
      duration: spec.duration,
      keys: position.map((curve) => ({
        attribute: curve.attribute,
        values: keys(curve),
      })),
      rotation: rotation ? {
        values: rotation.keys.map((key) => vectorAxis(key.value, 'z')),
        times: rotation.keys.map((key) => Number(key.time)),
      } : null,
      childRotations: rotationCurves
        .filter((curve) => curve !== rotation)
        .map((curve) => ({
          path: curve.path,
          values: curve.keys.map((key) => ({ x: vectorAxis(key.value, 'x'), y: vectorAxis(key.value, 'y'), z: vectorAxis(key.value, 'z') })),
          times: curve.keys.map((key) => Number(key.time)),
        })),
      childAlphas: curves
        .filter((curve) => curve.collection === 'm_FloatCurves' && curve.attribute === 'm_Color.a' && curve.path !== spec.path)
        .map((curve) => ({
          path: curve.path,
          values: keys(curve),
        })),
      childPositions: position
        .filter((curve) => curve.path !== spec.path)
        .map((curve) => ({
          path: curve.path,
          attribute: curve.attribute,
          values: keys(curve),
        })),
      scale: scale ? {
        valuesX: scale.keys.map((key) => vectorAxis(key.value, 'x')),
        valuesY: scale.keys.map((key) => vectorAxis(key.value, 'y')),
        times: scale.keys.map((key) => Number(key.time)),
      } : null,
      alpha: alpha ? keys(alpha) : null,
    };
    if (!out[spec.button]) out[spec.button] = [];
    out[spec.button].push(entry);
  }
  return out;
}

function tarotButtonEffTimings() {
  const clip = 'TarotBookRealMainPage_FadeIn.anim';
  const out = {};
  for (const name of TAROT_BUTTON_ORDER) {
    const prefix = `Root/PanelContent/DesktopPanel/FunctionList/${name}/Root/IconPanel/Eff`;
    const read = (attribute, path = prefix) => {
      const curve = tarotCurve(clip, path, attribute);
      const keys = curve?.keys ?? [];
      return {
        keys: keys.map((key) => ({ time: Number(key.time), value: Number(key.value) || 0 })),
        delay: Number(keys[0]?.time ?? 0),
        duration: Number(keys[keys.length - 1]?.time ?? 0) - Number(keys[0]?.time ?? 0),
      };
    };
    out[name] = {
      ...read('m_Color.a'),
      bgHint: read('m_Color.a', `${prefix}/BgHint`),
      deco: read('m_Color.a', `${prefix}/Deco`),
    };
  }
  return out;
}

// FunctionList buttons use different alpha/eff windows in each official
// homepage entrance clip. Keep them per variant instead of stamping the
// opening clip's times onto every state.
function tarotHomeEntranceButtonTimings() {
  const variants = {
    opening: 'TarotBookRealMainPage_FadeIn.anim',
    firstTime: 'TarotBookRealMainPage_FadeIn_FirstTime.anim',
    returning: 'TarotBookRealMainPage_FadeIn_Switch.anim',
    resume: 'TarotBookRealMainPage_FadeIn3.anim',
  };
  const out = {};
  for (const [variant, clip] of Object.entries(variants)) {
    out[variant] = {};
    for (const name of TAROT_BUTTON_ORDER) {
      const base = `Root/PanelContent/DesktopPanel/FunctionList/${name}`;
      const read = (attribute, path = base) => {
        const keys = tarotCurve(clip, path, attribute)?.keys ?? [];
        return {
          delay: Number(keys[0]?.time ?? 0),
          duration: Number(keys[keys.length - 1]?.time ?? 0) - Number(keys[0]?.time ?? 0),
          keys: keys.map((key) => ({ time: Number(key.time), value: Number(key.value) || 0 })),
        };
      };
      const effBase = `${base}/Root/IconPanel/Eff`;
      out[variant][name] = {
        reveal: read('m_Alpha'),
        eff: read('m_Color.a', effBase),
        bgHint: read('m_Color.a', `${effBase}/BgHint`),
        deco: read('m_Color.a', `${effBase}/Deco`),
      };
    }
  }
  return out;
}

// The official Error clip is not a route in the fanwork; it is exported so the
// runtime failure state can use the same button/scanline windows and colors.
function tarotErrorTiming() {
  const clip = 'TarotBookRealMainPage_FadeIn_Error.anim';
  const keysFor = (path, attribute) => (tarotCurve(clip, path, attribute)?.keys ?? [])
    .map((key) => ({ time: Number(key.time), value: Number(key.value) || 0 }));
  const curveFor = (path, attribute) => {
    const keys = keysFor(path, attribute);
    if (keys.length < 2) return null;
    return {
      delay: Number(keys[0].time),
      duration: Number((Number(keys[keys.length - 1].time) - Number(keys[0].time)).toFixed(6)),
      keys,
    };
  };
  const buttons = {};
  for (const name of TAROT_BUTTON_ORDER) {
    const icon = `Root/PanelContent/DesktopPanel/FunctionList/${name}/Root/IconPanel`;
    const frame = `${icon}/Frame`;
    const errorIcon = `${icon}/Error/EffErrorIcon`;
    const glitch = `${icon}/Error/Glitch`;
    buttons[name] = {
      reveal: curveFor(`Root/PanelContent/DesktopPanel/FunctionList/${name}`, 'm_Alpha'),
      error: curveFor(`${icon}/Error`, 'm_Alpha'),
      errorActive: curveFor(`${icon}/Error`, 'm_IsActive'),
      errorIconActive: curveFor(errorIcon, 'm_IsActive'),
      glitchW: keysFor(glitch, 'material._DisTex_ST.w'),
      frameR: keysFor(frame, 'm_Color.r'),
      frameG: keysFor(frame, 'm_Color.g'),
      frameB: keysFor(frame, 'm_Color.b'),
      frameAlpha: curveFor(frame, 'm_Color.a'),
      scanlineW: keysFor(`${icon}/Error/Scanline`, 'material._MaskTex_ST.w'),
    };
  }
  return {
    buttons,
    background: curveFor('Root/ErrorBg', 'm_Alpha'),
    backgroundActive: curveFor('Root/ErrorBg', 'm_IsActive'),
    errorOpen: keysFor('Root/ErrorBg/EffErrorOpen', 'm_IsActive'),
    screenBackground: curveFor('Bg/ScreenBg/RevertMask/ErrorBg', 'm_IsActive'),
    effLoop: curveFor('Bg/ScreenBg/RevertMask/BgRoot/EffLoop', '_TargetAlpha'),
    scanline: {
      w: keysFor('Root/ErrorBg/Scanline', 'material._MaskTex_ST.w'),
      x: keysFor('Root/ErrorBg/Scanline', 'material._MaskTex_ST.x'),
      y: keysFor('Root/ErrorBg/Scanline', 'material._MaskTex_ST.y'),
      z: keysFor('Root/ErrorBg/Scanline', 'material._MaskTex_ST.z'),
    },
    scanlineW: keysFor('Root/ErrorBg/Scanline', 'material._MaskTex_ST.w'),
  };
}

function tarotDialogTiming() {
  const floatKeys = (clipName, path, attribute) => (tarotCurve(clipName, path, attribute)?.keys ?? [])
    .map((key) => ({ time: Number(key.time), value: Number(key.value) || 0 }));
  const floatCurve = (clipName, path, attribute) => {
    const keys = floatKeys(clipName, path, attribute);
    if (keys.length < 2) return null;
    return { delay: Number(keys[0].time), duration: Number((Number(keys[keys.length - 1].time) - Number(keys[0].time)).toFixed(6)), keys };
  };
  const scaleCurve = (clipName, path) => (tarotCurve(clipName, path, '')?.keys ?? []);
  const dialogFade = 'TarotBookMainEntranceErrorDialog_FadeIn.anim';
  const dialogLoop = 'TarotBookMainEntranceErrorDialog_Loop.anim';
  const dialogExit = 'TarotBookMainEntranceErrorDialog_FadeOut.anim';
  const mailFade = 'TarotBookMailDialog_FadeIn.anim';
  const guide = 'TarotBookGuideBtnTypeRect.anim';
  return {
    dialog: {
      contentsAlpha: floatCurve(dialogFade, 'Contents', 'm_Alpha'),
      contentsY: floatKeys(dialogFade, 'Contents', 'm_AnchoredPosition.y'),
      frameWidth: floatKeys(dialogFade, 'Contents/DataHintPanel/Frame', 'm_SizeDelta.x'),
      frameHeight: floatKeys(dialogFade, 'Contents/DataHintPanel/Frame', 'm_SizeDelta.y'),
      titleScaleX: scaleCurve(dialogFade, 'Contents/DataHintPanel/TitlePanel/Frame/Bg'),
      frameWobbleX: floatKeys(dialogLoop, 'DataHintPanel/Frame', 'm_AnchoredPosition.x'),
      frameWobbleY: floatKeys(dialogLoop, 'DataHintPanel/Frame', 'm_AnchoredPosition.y'),
      titleFlicker: floatCurve(dialogLoop, 'DataHintPanel/TitlePanel/Frame/Bg', 'm_Alpha'),
      exitGlowScaleY: scaleCurve(dialogExit, 'Closing/Frame/Black/Glow'),
      exitGlowScaleY2: scaleCurve(dialogExit, 'Closing/Frame/Black/Glow_02'),
    },
    mail: {
      panelAlpha: floatKeys(mailFade, 'Root', 'm_Alpha'),
      pageInfoAlpha: floatCurve(mailFade, 'Root/PageInfo', 'm_Alpha'),
      lineScaleX: scaleCurve(mailFade, 'Root/Contents/Line'),
      iconScale: scaleCurve(mailFade, 'Root/Contents/MailContent/BaseInfo/IconPanel/Icon'),
    },
    guide: {
      frameScale: scaleCurve(guide, 'FrameLoop/Frame'),
      whiteFlash: floatCurve(guide, 'FrameLoop/Frame/FrameWhite', 'm_Alpha'),
      rootAlpha: floatCurve(guide, 'Root', 'm_Alpha'),
    },
  };
}

function tarotMimiTiming() {
  const floatKeys = (clipName, path, attribute) => (tarotCurve(clipName, path, attribute)?.keys ?? []).map((key) => ({ time: Number(key.time), value: Number(key.value) || 0 }));
  const floatCurve = (clipName, path, attribute) => {
    const keys = floatKeys(clipName, path, attribute);
    if (keys.length < 2) return null;
    return { delay: Number(keys[0].time), duration: Number((Number(keys[keys.length - 1].time) - Number(keys[0].time)).toFixed(6)), keys };
  };
  const scaleKeys = (clipName, path) => (tarotCurve(clipName, path, '')?.keys ?? []);
