      starAlpha: floatCurve(unlock, 'UnlockHint/Star', 'm_Alpha'),
      star2Alpha: floatCurve(unlock, 'UnlockHint/Star2', 'm_Alpha'),
    },
    item: {
      lineScale: scaleKeys(item, 'Line'),
    },
    guide: {
      bgAlpha: floatCurve(guideIn, 'Root/HintPanel/Bg', 'm_Alpha'),
      iconAlpha: floatCurve(guideIn, 'Root/HintPanel/IconPanel', 'm_Alpha'),
      hintTextAlpha: floatCurve(guideIn, 'Root/HintPanel/TextPanel/HintText', 'm_Alpha'),
      functionAlpha: floatCurve(guideIn, 'Root/HintPanel/FunctionPanel', 'm_Alpha'),
      glowAlpha: floatCurve(guideIn, 'Root/HintPanel/Bg/Mask/GlowFlow', 'm_Alpha'),
      bgScaleX: [...(tarotCurve(guideIn, 'Root/HintPanel/Bg', '')?.keys ?? []), ...(tarotCurve(guideOut, 'Root/HintPanel/Bg', '')?.keys ?? [])].map((key) => ({ time: Number(key.time), value: Number(String(key.value).match(/x:\s*([-\d.e]+)/)?.[1] ?? 0) })),
      iconScale: [...(tarotCurve(guideIn, 'Root/HintPanel/IconPanel/EffSiriSP', '')?.keys ?? []), ...(tarotCurve(guideOut, 'Root/HintPanel/IconPanel/EffSiriSP', '')?.keys ?? [])].map((key) => ({ time: Number(key.time), value: Number(String(key.value).match(/x:\s*([-\d.e]+)/)?.[1] ?? 0) })),
      exitIconAlpha: floatCurve(guideOut, 'Root/HintPanel/IconPanel', 'm_Alpha'),
