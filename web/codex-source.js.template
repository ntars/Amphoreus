function tarotChapterColors() {
  const colors = TAROT_SOURCE.colors || {};
  const chapters = ['1', '01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12', '13'];
  const keys = ['banner', 'circle', 'backCircle', 'deco', 'symbol', 'spSymbol', 'character'];
  const result = {};
  for (const chapter of chapters) {
    const chapterKey = chapter === '01' ? '1' : chapter;
    const entry = result[chapterKey] || (result[chapterKey] = {});
    for (const key of keys) {
      for (const suffix of ['', 'Active']) {
        const name = 'chapter' + chapter + key + suffix;
        // Some official card folders only ship the Active silhouette. Reusing
        // that same source color is preferable to inventing an inactive shade.
        entry[key + suffix] = colors[name]?.css || colors[name + 'Active']?.css || 'transparent';
      }
    }
  }
  return result;
}

function tarotChapterVectors() {
  const chapters = ['1', '01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12', '13'];
  const keys = ['banner', 'circle', 'backCircle', 'deco', 'symbol', 'spSymbol'];
  const activeKeys = ['symbol', 'spSymbol', 'character'];
  const result = {};
  for (const chapter of chapters) {
    const chapterKey = chapter === '01' ? '1' : chapter;
    const entry = result[chapterKey] || (result[chapterKey] = {});
    for (const key of keys) {
      entry[key] = tarotVector('chapter' + chapter + key) || tarotVector('chapter' + chapter + key + 'Active');
      entry[key + 'Active'] = tarotVector('chapter' + chapter + key + 'Active');
    }
    for (const key of activeKeys) entry[key] = tarotVector('chapter' + chapter + key);
  }
  return result;
}

