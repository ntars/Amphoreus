  const pageInfoX = tarotTiming(clip, 'Outside/PageInfo', 'm_AnchoredPosition.x');
  const pageInfoXValues = tarotCurveValues(clip, 'Outside/PageInfo', 'm_AnchoredPosition.x');
  const storyPanels = [];
  for (let i = 1; i <= 12; i += 1) {
    const path = `Root/CenterPanel/Content/StarContent/StoryStarPanel${i}/Progress`;
    const timing = tarotTiming(clip, path, 'm_Alpha');
    if (timing.keys.length) storyPanels.push({
      ...timing,
      values: tarotCurveValues(clip, path, 'm_Alpha'),
    });
  }
  return {
    star: tarotTiming(clip, 'Root/CenterPanel/Content/StarContent', 'm_Alpha'),
    particleOpen: (tarotCurve(clip, 'Root/CenterPanel/Content/StarContentEff/ParticleOpen', 'm_IsActive')?.keys ?? []).map((key) => ({
      time: Number(key.time),
      value: Number(key.value) || 0,
    })),
    story: tarotTiming(clip, 'Root/CenterPanel/Content/StarContent/StoryStarPanel6/Progress', 'm_Alpha'),
    rotation,
    effectRotation,
    rootAlpha,
    pageAlpha,
    backAlpha,
    pageInfo,
    pageInfoX,
    pageInfoXValues,
    storyPanels,
  };
}

