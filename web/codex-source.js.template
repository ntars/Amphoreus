// Official selectable-state clips share the same hashed node paths. The
// highlighted/pressed pulse drives the visible selection ring, while the four
// script RGBA channels supply the official disabled/pressed/selected palette.
function tarotButtonStates() {
  const read = (file) => {
    const channels = {};
    for (const clip of TAROT_SOURCE.animations || []) {
      if (clip.file !== file) continue;
      for (const curve of clip.curves || []) {
        if (!curve.keys?.length) continue;
        const value = Number(curve.keys[curve.keys.length - 1].value);
        if (curve.attribute.startsWith('script_')) channels[curve.attribute] = value;
        if (curve.attribute === 'm_IsActive' && curve.path === 'path_2774779617') {
          channels.active = value;
        }
        if (curve.attribute === 'typetree_1574349066' && curve.path === 'path_2774779617') {
          channels.pulse = (curve.keys || []).map((key) => ({
            time: Number(key.time),
            value: Number(key.value),
          }));
        }
      }
    }
    return channels;
  };
  const states = Object.fromEntries(['Normal', 'Disabled', 'Highlighted', 'Pressed', 'Selected'].map((name) => [name, read(`${name}.anim`)]));
  const parts = (channels) => {
    const values = [channels.script_2526845255, channels.script_4215373228, channels.script_2334886179, channels.script_304273561]
      .map((value) => Number(value ?? 0));
    return {
      rgba: values.join(' '),
      rgb: values.slice(0, 3).join(' '),
      alpha: values[3],
      points: (channels.pulse || []).map((point, index) => ({
        at: `${((point.time / (channels.pulse?.[channels.pulse.length - 1]?.time || 1)) * 100).toFixed(4)}%`,
        value: point.value,
      })),
    };
  };
  return Object.fromEntries(Object.entries(states).map(([name, state]) => {
    const color = parts(state);
    return [name, {
      ...color,
      active: Number(state.active ?? 0),
      pulse: state.pulse || [],
      duration: state.pulse?.[state.pulse.length - 1]?.time ?? 0,
    }];
  }));
}

// The long-press signing flow is a separate official interaction. Its hashed
