function tarotMaterialColors() {
  const materials = TAROT_SOURCE.materials || {};
  const out = {};
  for (const [key, value] of Object.entries(materials)) {
    if (!value || key === 'scene') continue;
    if (value.css) {
      out[key] = value.css;
      continue;
    }
    if (!value.color) continue;
    const [r, g, b] = value.color;
    out[key] = `rgba(${r}, ${g}, ${b}, ${value.alpha})`;
  }
  return out;
}

function tarotSpriteSamples() {
  const out = {};
  for (const [key, value] of Object.entries(TAROT_SOURCE.sprites || {})) {
    const alpha = value?.alpha || [];
    const colors = value?.colors || [];
    out[`${key}Alpha`] = alpha;
    out[`${key}Colors`] = colors;
  }
  return out;
}

function tarotSceneColors() {
  const scene = TAROT_SOURCE.materials?.scene || {};
  return Object.fromEntries(Object.entries(scene).map(([name, value]) => [name, value?.css || 'transparent']));
}

// Average the unpacked texture samples into CSS-ready colors. The source is
// sampled at build time; runtime still draws every particle with CSS only.
function tarotTextureColors() {
  const out = {};
  for (const [name, texture] of Object.entries(TAROT_SOURCE.textures || {})) {
    const samples = (texture?.colors || []).flat().filter((sample) => sample?.color?.length === 3);
    if (!samples.length) continue;
    const sum = samples.reduce((acc, sample) => {
      acc.rgb[0] += Number(sample.color[0]) || 0;
      acc.rgb[1] += Number(sample.color[1]) || 0;
      acc.rgb[2] += Number(sample.color[2]) || 0;
      acc.alpha += Number(sample.alpha) || 0;
      return acc;
    }, { rgb: [0, 0, 0], alpha: 0 });
    const rgb = sum.rgb.map((channel) => Math.round(channel / samples.length));
    const alpha = Math.min(1, Math.max(0, sum.alpha / samples.length));
    out[name] = `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, ${Number(alpha.toFixed(4))})`;
  }
  return out;
}

