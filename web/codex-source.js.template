// The app enters the homepage through three official entrance variants: the
// initial cover reveal, a return from another archive, and a cover-to-home
// transition. Keep each clip's real key times instead of copying one timing
// into every state.
function tarotHomeEntranceTimings() {
  const variants = {
    opening: 'TarotBookRealMainPage_FadeIn.anim',
    firstTime: 'TarotBookRealMainPage_FadeIn_FirstTime.anim',
    returning: 'TarotBookRealMainPage_FadeIn_Switch.anim',
    resume: 'TarotBookRealMainPage_FadeIn3.anim',
  };
  const out = {};
  for (const [name, clip] of Object.entries(variants)) {
    out[name] = {
      root: tarotTiming(clip, 'Root', 'm_Alpha'),
      screen: tarotTiming(clip, 'Bg/ScreenBg', 'm_Alpha'),
      close: tarotTiming(clip, 'Outside/BtnClose', 'm_Alpha'),
      pageInfo: tarotTiming(clip, 'Outside/PageInfo', 'm_Alpha'),
      reward: tarotTiming(clip, 'Outside/RewardPanel', 'm_Alpha'),
      desktop: tarotTiming(clip, 'Root/PanelContent/DesktopPanel', 'm_Alpha'),
      pageInfoX: tarotCurveValues(clip, 'Outside/PageInfo', 'm_AnchoredPosition.x'),
      rewardX: tarotCurveValues(clip, 'Outside/RewardPanel', 'm_AnchoredPosition.x'),
      bottomBar: tarotTiming(clip, 'Bg/ScreenBg/BottomBar', 'm_Alpha'),
      // Unity stores transform scales as vector strings; tarotCurveValues()
      // coerces them to numbers, so preserve the raw key values for CSS.
      screenScale: (tarotCurve(clip, 'Bg', '')?.keys ?? []).map((key) => ({ time: Number(key.time), value: key.value })),
      desktopScale: (tarotCurve(clip, 'Root/PanelContent/DesktopPanel/Bg', '')?.keys ?? []).map((key) => ({ time: Number(key.time), value: key.value })),
      backgroundAlpha: tarotTiming(clip, 'Bg', 'm_Alpha'),
      goToPanel: tarotTiming(clip, 'Root/PanelContent/GoToPanel', 'm_Alpha'),
      newMailHint: tarotTiming(clip, 'Root/PanelContent/DesktopPanel/NewMailHint', 'm_Alpha'),
      newMailEff: tarotTiming(clip, 'Root/PanelContent/DesktopPanel/NewMailHint/IconPanel/EffLoop', '_TargetAlpha'),
      outsideContent: tarotTiming(clip, 'Outside/Content', 'm_Alpha'),
      effOpen: (() => {
        const keys = (tarotCurve(clip, 'Bg/EffOpen', 'm_IsActive')?.keys ?? []).map((key) => ({
          time: Number(key.time),
          value: Number(key.value) || 0,
        }));
        const active = keys.find((key) => key.value) || keys[keys.length - 1];
        const off = keys.find((key) => key.time > (active?.time ?? Infinity) && !key.value);
        return {
          keys,
          delay: Number(keys[0]?.time ?? 0),
          duration: Number((active?.time ?? keys[keys.length - 1]?.time ?? 0)) - Number(keys[0]?.time ?? 0),
          activeTime: Number(active?.time ?? 0),
          offDelay: Number(off?.time ?? active?.time ?? 0),
        };
      })(),
      bgRootEff: (() => {
        const keys = (tarotCurve(clip, 'Bg/ScreenBg/RevertMask/BgRoot/EffLoop', '_TargetAlpha')?.keys ?? []).map((key) => ({
          time: Number(key.time),
          value: Number(key.value) || 0,
        }));
        return {
          keys,
          delay: Number(keys[0]?.time ?? 0),
          duration: Number(keys[keys.length - 1]?.time ?? 0) - Number(keys[0]?.time ?? 0),
        };
      })(),
    };
  }
  return out;
}

