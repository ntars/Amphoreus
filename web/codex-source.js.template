function tarotCurveValues(clipName, path, attribute) {
  const curve = tarotCurve(clipName, path, attribute);
  const keys = curve?.keys ?? [];
  return keys.map((key) => ({
    time: Number(key.time),
    value: Number(key.value) || 0,
    offset: keys.length ? Number(key.time) - Number(keys[0].time) : 0,
    percent: keys.length > 1 ? (Number(key.time) - Number(keys[0].time)) / (Number(keys[keys.length - 1].time) - Number(keys[0].time)) * 100 : 0,
  }));
}

function tarotEulerValues(clipName, path, axis) {
  const curve = tarotCurve(clipName, path, '');
  if (!curve) return [];
  const numbers = String(axis).split('.');
  return (curve.keys ?? []).map((key) => ({
    time: Number(key.time),
    value: vectorAxis(key.value, numbers[numbers.length - 1]),
  })).filter((key) => Number.isFinite(key.value));
}

