function tarotStarRings() {
  const rings = TAROT_SOURCE.layout.hierarchy.starRings || [];
  return Object.fromEntries(rings.map((ring) => [ring.name, {
    x: Number(ring.x ?? 0),
    y: Number(ring.y ?? 0),
    scaleX: Number(ring.scale?.[0] ?? 1),
    scaleY: Number(ring.scale?.[1] ?? 1),
  }]));
}
